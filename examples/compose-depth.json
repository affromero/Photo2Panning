      "font_size": 160,
      "color": "#edf4ed",
      "stroke_width": 2,
      "stroke_color": "#edf4ed",
      "duration": 3,
      "size": {"width": 1600, "height": 240},
      "keyframes": [
        {"at": 0, "x": 900, "y": 300},
        {"at": 3, "x": 900, "y": 280}
